# --- Node / React Native / Expo ---
node_modules/
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS / iOS / Android native build artifacts (if prebuild is ever run)
ios/
android/

# --- docs/api (TypeSpec -> OpenAPI3 -> HTML build output) ---
docs/api/openapi/
docs/api/html/
docs/api/tsp-output/

# --- PHP / Composer / Slim backend ---
backend/vendor/
backend/.env
backend/.env.*
!backend/.env.example
backend/.phpunit.result.cache
backend/var/
backend/secret.env
!backend/secret.env.example
composer.phar

# --- Env / secrets ---
.env
.env.local
.env.*.local

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
# mobile/'s Expo template ships shared (non-personal) extension recommendations
# and workspace settings that are meant to be committed.
!mobile/.vscode/
*.swp

# --- Logs ---
*.log
