APP_ENV=production
APP_DEBUG=false

# Comma-separated list of origins allowed to call this API cross-origin
# (native mobile clients don't send Origin, so this mainly matters for the
# web preview / deep-link landing page — PRD §56).
CORS_ALLOWED_ORIGINS=https://yotee.net

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yotee
DB_USERNAME=yotee
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# HS256 signing secret for access tokens. Generate with e.g.
# `openssl rand -base64 48`. Never reuse across environments.
JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=com.example.yotee

# Fixed-window request cap per client per window, enforced by RateLimitMiddleware.
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
