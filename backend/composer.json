{
    "name": "yotee/backend",
    "description": "Yotee API backend. Route -> Controller -> Service -> Repository -> PDO -> MySQL. See CLAUDE.md for the architectural rules this must not violate.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "slim/slim": "^4.15.2",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.1",
        "ramsey/uuid": "^4.7",
        "monolog/monolog": "^3.9",
        "respect/validation": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "phinx migrate -c config/phinx.php",
        "migrate:rollback": "phinx rollback -c config/phinx.php"
    }
}
