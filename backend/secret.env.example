# Copy this file to `secret.env` (same directory, gitignored — never commit
# it) and fill in real values. Then run:
#
#   bash scripts/push-secrets.sh
#
# from inside backend/. That uploads everything below as encrypted GitHub
# Actions secrets and nothing else — the deploy workflow itself never reads
# secret.env, only `secrets.*`. Safe to delete secret.env again afterwards;
# re-run the script whenever a value changes.

# --- Deploy connection (consumed only by scripts/push-secrets.sh, never
#     shipped to the server or read by the workflow) ---
DEPLOY_SSH_HOST=xxxxx.xserver.jp
DEPLOY_SSH_PORT=10022
DEPLOY_SSH_USER=xsXXXXXX
# Absolute path on THIS machine to the private key matching a public key
# already registered on the server (Xserver: SSH Keys under the server panel).
DEPLOY_SSH_KEY_PATH=/absolute/path/to/your/private_key
# Absolute path on the SERVER where backend/ should live. Must NOT be inside
# the domain's public (document root) folder — only backend/public/ should
# be exposed there (see backend/public/.htaccess and backend/.htaccess).
DEPLOY_PATH=/home/xsXXXXXX/example.com/backend
# Only needed if `composer` isn't directly on PATH over SSH — e.g. if you
# installed composer.phar by hand: DEPLOY_COMPOSER_BIN=php ~/composer.phar
DEPLOY_COMPOSER_BIN=composer

# --- Everything below is written verbatim to backend/.env on the server —
#     keep this in sync with backend/.env.example's keys ---
APP_ENV=production
APP_DEBUG=false
CORS_ALLOWED_ORIGINS=https://yotee.net
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yotee
DB_USERNAME=yotee
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=com.example.yotee
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
